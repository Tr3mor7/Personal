; Short restrained equilibration after EM: heavy atoms restrained (pdb2gmx posre.itp
; and/or lipid restraints with -DPOSRES), small time step to let hydrogens and
; junctions relax.
define          = -DPOSRES
integrator      = md
dt              = 0.001
nsteps          = 50000        ; 50 ps
nstxout-compressed = 5000
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.2
vdwtype         = Cut-off
vdw-modifier    = Force-switch
rvdw-switch     = 1.0
rvdw            = 1.2
tcoupl          = V-rescale
tc-grps         = System
tau-t           = 1.0
ref-t           = 310
pcoupl          = no
gen-vel         = yes
gen-temp        = 310
constraints     = h-bonds
constraint-algorithm = LINCS
pbc             = xyz
