; Energy minimisation of a freshly backmapped structure (CHARMM36-style settings).
; If it stops with "infinite force", re-run m3backmap with --prune-water 0.2
; and/or more --relax-iter, or minimise first with a smaller emstep.
integrator      = steep
emtol           = 500.0
emstep          = 0.002
nsteps          = 20000
cutoff-scheme   = Verlet
nstlist         = 10
coulombtype     = PME
rcoulomb        = 1.2
vdwtype         = Cut-off
vdw-modifier    = Force-switch
rvdw-switch     = 1.0
rvdw            = 1.2
constraints     = none
pbc             = xyz
